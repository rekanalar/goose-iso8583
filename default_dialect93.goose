fn dialect_default_1993_ascii(d: Dialect&) {
    dialect_init(d, ENC_ASCII, BITMAP_HEX_ASCII, 2);
    for r in 0..126 {
        let b = r * 16;
        dialect_field(d, T93[b], T93[b + 1], T93[b + 4], T93[b + 5],
                      T93[b + 6], T93[b + 2], T93[b + 7], T93[b + 3]);
        if T93[b + 8] != 0 || T93[b + 9] != -1 {
            dialect_field_pad(d, path1(T93[b]), T93[b + 8], T93[b + 9]);
        }
    }
}

fn dialect_default_1993_binary(d: Dialect&) {
    dialect_init(d, ENC_BCD, BITMAP_BINARY, 2);
    for r in 0..126 {
        let b = r * 16;
        dialect_field(d, T93[b], T93[b + 1], T93[b + 10], T93[b + 11],
                      T93[b + 12], T93[b + 2], T93[b + 13], T93[b + 3]);
        if T93[b + 14] != 0 || T93[b + 15] != -1 {
            dialect_field_pad(d, path1(T93[b]), T93[b + 14], T93[b + 15]);
        }
    }
}
